# Required for Umami stats
# Umami Cloud example:
# UMAMI_BASE_URL=https://api.umami.is/v1
# UMAMI_WEBSITE_ID=your-website-uuid
# UMAMI_SHARE_URL=https://cloud.umami.is/share/your-share-id
# UMAMI_API_KEY=your-api-key
#
# Self-hosted Umami example:
# UMAMI_BASE_URL=https://umami.example.com
# UMAMI_WEBSITE_ID=your-website-uuid
# UMAMI_SHARE_URL=https://umami.example.com/share/your-share-id
# UMAMI_AUTH_TOKEN=your-bearer-token
#
# If you prefer username/password login, leave UMAMI_AUTH_TOKEN empty and set:
# UMAMI_USERNAME=your-username
# UMAMI_PASSWORD=your-password