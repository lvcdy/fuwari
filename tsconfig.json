{
	"compilerOptions": {
		"target": "ES2020",
		"useDefineForClassFields": true,
		"lib": [
			"ES2020",
			"DOM",
			"DOM.Iterable"
		],
		"module": "ESNext",
		"skipLibCheck": true,
		"strict": true,
		"strictNullChecks": true,
		"allowJs": false,
		"declaration": true,
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"ignoreDeprecations": "6.0",
		"baseUrl": ".",
		"paths": {
			"@components/*": [
				"./src/components/*"
			],
			"@assets/*": [
				"./src/assets/*"
			],
			"@constants/*": [
				"./src/constants/*"
			],
			"@utils/*": [
				"./src/utils/*"
			],
			"@i18n/*": [
				"./src/i18n/*"
			],
			"@layouts/*": [
				"./src/layouts/*"
			],
			"@/*": [
				"./src/*"
			]
		},
	},
	"include": [
		"src/**/*"
	]
}
