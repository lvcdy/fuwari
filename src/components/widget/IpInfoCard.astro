---
interface Props {
	class?: string;
	style?: string;
}

const {
	class: className = "",
	style = "",
} = Astro.props;

const rootId = `ip-info-card-${Math.random().toString(36).slice(2, 10)}`;
const endpoint = "/api/ip-info.json";
---

<aside
	id={rootId}
	class:list={["card-base p-3", className]}
	style={style}
	data-endpoint={endpoint}
>
	<div class="flex items-center justify-between mb-3">
		<div class="flex items-center gap-2">
			<span class="flex h-8 w-8 items-center justify-center rounded-lg bg-[var(--btn-regular-bg)] text-sm font-bold text-[var(--primary)]">
				IP
			</span>
			<div>
				<div class="text-sm font-bold text-90">访客网络</div>
				<div class="text-[0.7rem] text-50" data-ip-status>正在检测</div>
			</div>
		</div>
		<a
			href="https://ippure.com/MyIP-Info-API.html"
			target="_blank"
			rel="noopener noreferrer"
			class="link-lg text-[0.7rem] font-medium text-50 hover:text-[var(--primary)]"
		>
			IPPure
		</a>
	</div>

	<div class="rounded-xl bg-[var(--btn-regular-bg)] p-3">
		<div class="text-[0.7rem] text-50 mb-1">当前 IP</div>
		<div class="font-mono text-sm font-bold leading-snug text-90 break-all" data-ip-value>
			...
		</div>
	</div>

	<div class="grid grid-cols-2 gap-2.5 mt-2.5">
		<div class="rounded-xl bg-[var(--btn-regular-bg)] p-2.5">
			<div class="text-[0.65rem] text-50 mb-1">位置</div>
			<div class="text-xs font-bold text-90 truncate" data-ip-location>...</div>
		</div>
		<div class="rounded-xl bg-[var(--btn-regular-bg)] p-2.5">
			<div class="text-[0.65rem] text-50 mb-1">ASN</div>
			<div class="text-xs font-bold text-90 truncate" data-ip-asn>...</div>
		</div>
		<div class="hidden rounded-xl bg-[var(--btn-regular-bg)] p-2.5" data-ip-risk-card>
			<div class="text-[0.65rem] text-50 mb-1">风险</div>
			<div class="text-xs font-bold text-90 truncate" data-ip-risk>...</div>
		</div>
		<div class="hidden rounded-xl bg-[var(--btn-regular-bg)] p-2.5" data-ip-type-card>
			<div class="text-[0.65rem] text-50 mb-1">类型</div>
			<div class="text-xs font-bold text-90 truncate" data-ip-type>...</div>
		</div>
	</div>

	<div class="mt-2.5 rounded-xl bg-[var(--btn-regular-bg)] p-2.5">
		<div class="text-[0.65rem] text-50 mb-1">运营商</div>
		<div class="text-xs font-bold text-90 truncate" data-ip-org>...</div>
	</div>
</aside>

<script is:inline define:vars={{ rootId }}>
	const root = document.getElementById(rootId);

	if (root instanceof HTMLElement) {
		const endpoint = root.dataset.endpoint || "";
		const nodes = {
			status: root.querySelector("[data-ip-status]"),
			ip: root.querySelector("[data-ip-value]"),
			location: root.querySelector("[data-ip-location]"),
			asn: root.querySelector("[data-ip-asn]"),
			riskCard: root.querySelector("[data-ip-risk-card]"),
			risk: root.querySelector("[data-ip-risk]"),
			typeCard: root.querySelector("[data-ip-type-card]"),
			type: root.querySelector("[data-ip-type]"),
			org: root.querySelector("[data-ip-org]"),
		};

		const setText = (node, value) => {
			if (node) node.textContent = value || "未知";
		};

		const setOptionalText = (card, node, value) => {
			if (!card || !node) return;

			if (value) {
				node.textContent = value;
				card.classList.remove("hidden");
			} else {
				card.classList.add("hidden");
			}
		};

		const formatLocation = (data) => {
			const parts = [data.city, data.region, data.countryCode || data.country]
				.map((item) => String(item || "").trim())
				.filter(Boolean);

			return parts.join(" / ");
		};

		const formatRisk = (score) => {
			if (score === undefined || score === null || score === "") return "";

			const value = Number(score);
			if (Number.isNaN(value)) return String(score);

			return `${value}/100`;
		};

		const formatType = (data) => {
			if (data.isResidential === true) return "住宅 IP";
			if (data.isBroadcast === true) return "广播 IP";
			if (data.isResidential === false) return "非住宅";
			return "";
		};

		const renderInfo = (data) => {
			setText(nodes.status, data.timezone || "检测完成");
			setText(nodes.ip, data.ip);
			setText(nodes.location, formatLocation(data));
			setText(nodes.asn, data.asn ? `AS${data.asn}` : "未提供");
			setOptionalText(nodes.riskCard, nodes.risk, formatRisk(data.fraudScore));
			setOptionalText(nodes.typeCard, nodes.type, formatType(data));
			setText(nodes.org, data.asOrganization);
		};

		const loadInfo = async () => {
			try {
				const response = await fetch(endpoint, {
					cache: "no-store",
					headers: {
						accept: "application/json",
					},
				});

				if (!response.ok) {
					throw new Error("Failed to fetch IP info");
				}

				renderInfo(await response.json());
			} catch {
				root.classList.add("hidden");
			}
		};

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", loadInfo, { once: true });
		} else {
			loadInfo();
		}

		const handleAfterSwap = () => {
			loadInfo();
		};

		document.addEventListener("astro:after-swap", handleAfterSwap);
		document.addEventListener(
			"astro:before-swap",
			() => {
				document.removeEventListener("astro:after-swap", handleAfterSwap);
			},
			{ once: true },
		);
	}
</script>
