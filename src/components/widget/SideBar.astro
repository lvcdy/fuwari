---
import type { MarkdownHeading } from "astro";
import Categories from "./Categories.astro";
import Profile from "./Profile.astro";
import Stats from "./Stats.svelte";
import Tags from "./Tags.astro";
import { getPostBody, getSortedPosts } from "@/utils/content-utils";
import { safeGetSiteStats } from "@/utils/stats";
import { countWords } from "@/utils/text-utils";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
}

const className = Astro.props.class;

const [posts, siteStats] = await Promise.all([
	getSortedPosts(),
	safeGetSiteStats(),
]);
const postCount = posts.length;
const postBodies = await Promise.all(posts.map((post) => getPostBody(post)));
const totalWords = postBodies.reduce((sum, body) => sum + countWords(body), 0);
---
<div id="sidebar" class:list={[className, "w-full"]}>
    <div class="flex flex-col w-full gap-4 mb-4">
        <Profile></Profile>
        <Stats
            client:load
            className="onload-animation"
            style="animation-delay: 100ms"
            initialPostCount={postCount}
            initialTotalWords={totalWords}
            initialVisits={siteStats.visits}
            initialPageviews={siteStats.pageviews}
        ></Stats>
    </div>
    <div id="sidebar-sticky" class="transition-all duration-700 flex flex-col w-full gap-4 top-4 sticky top-4">
        <Categories class="onload-animation" style="animation-delay: 150ms"></Categories>
        <Tags class="onload-animation" style="animation-delay: 200ms"></Tags>
    </div>
</div>
