---
import { Icon } from "astro-icon/components";
import type { UmamiStats } from "@/utils/umami-stats";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getCategoryUrl, getTagUrl } from "../utils/url-utils";
import TrafficStats from "./misc/TrafficStats.astro";

interface Props {
	class: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	hideTagsForMobile?: boolean;
	hideUpdateDate?: boolean;
	statsPath?: string;
	stats?: Pick<UmamiStats, "visits" | "pageviews">;
}

const {
	published,
	updated,
	tags,
	category,
	hideTagsForMobile = false,
	hideUpdateDate = false,
	statsPath,
	stats,
} = Astro.props;
const className = Astro.props.class;
const normalizedTags = tags.map((tag) => tag.trim()).filter(Boolean);
const hasTags = normalizedTags.length > 0;
const categoryLabel = category || i18n(I18nKey.uncategorized);

type MetaEntry = {
	icon: string;
	label: string;
	href?: string;
	ariaLabel?: string;
};

const metaEntries: MetaEntry[] = [
	{
		icon: "material-symbols:calendar-today-outline-rounded",
		label: formatDateToYYYYMMDD(published),
	},
];

if (!hideUpdateDate && updated && updated.getTime() !== published.getTime()) {
	metaEntries.push({
		icon: "material-symbols:edit-calendar-outline-rounded",
		label: formatDateToYYYYMMDD(updated),
	});
}

metaEntries.push({
	icon: "material-symbols:book-2-outline-rounded",
	label: categoryLabel,
	href: getCategoryUrl(category),
	ariaLabel: `View all posts in the ${categoryLabel} category`,
});

type TagEntry = {
	label: string;
	href?: string;
	ariaLabel?: string;
};

const tagEntries: TagEntry[] = hasTags
	? normalizedTags.map((tag) => ({
			label: tag,
			href: getTagUrl(tag),
			ariaLabel: `View all posts with the ${tag} tag`,
		}))
	: [
			{
				label: i18n(I18nKey.noTags),
			},
		];
---

<div class:list={["flex flex-wrap text-neutral-500 dark:text-neutral-400 items-center gap-4 gap-x-4 gap-y-2", className]}>
	{metaEntries.map((item) => (
		<div class="flex items-center">
			<div class="meta-icon">
				<Icon name={item.icon} class="text-xl" />
			</div>
			{item.href ? (
				<div class="flex flex-row flex-nowrap items-center">
					<a
						href={item.href}
						aria-label={item.ariaLabel}
						class="link-lg transition text-50 text-sm font-medium hover:text-[var(--primary)] dark:hover:text-[var(--primary)] whitespace-nowrap"
					>
						{item.label}
					</a>
				</div>
			) : (
				<span class="text-50 text-sm font-medium">{item.label}</span>
			)}
		</div>
	))}

	<div class:list={["items-center", { flex: !hideTagsForMobile, "hidden md:flex": hideTagsForMobile }]}>
		<div class="meta-icon">
			<Icon name="material-symbols:tag-rounded" class="text-xl" />
		</div>
		<div class="flex flex-row flex-nowrap items-center">
			{hasTags ? (
				tagEntries.map((tag, index) => (
					<>
						{index > 0 && <div class="mx-1.5 text-[var(--meta-divider)] text-sm">/</div>}
						<a
							href={tag.href}
							aria-label={tag.ariaLabel}
							class="link-lg transition text-50 text-sm font-medium hover:text-[var(--primary)] dark:hover:text-[var(--primary)] whitespace-nowrap"
						>
							{tag.label}
						</a>
					</>
				))
			) : (
				<div class="transition text-50 text-sm font-medium">{tagEntries[0].label}</div>
			)}
		</div>
	</div>

	{statsPath && <TrafficStats mode="path" path={statsPath} compact={true} initialStats={stats} />}
</div>
