---
import type { CollectionEntry } from "astro:content";
import { getPostUrlBySlug } from "@utils/url-utils";
import PostCard from "./PostCard.astro";

const { page } = Astro.props;

const interval = 50;
const posts: Array<{
	post: CollectionEntry<"posts">;
	url: string;
	style: string;
}> = page.data.map((post: CollectionEntry<"posts">, index: number) => ({
	post,
	url: getPostUrlBySlug(post.id),
	style: `animation-delay: calc(var(--content-delay) + ${index * interval}ms);`,
}));
---
<div class="transition flex flex-col gap-3 md:gap-4 mb-4">
	{posts.map(({ post, url, style }) => (
		<PostCard post={post} url={url} class:list="onload-animation" style={style} />
	))}
</div>
