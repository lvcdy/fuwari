---
interface Props {
	class?: string;
}

const className = Astro.props.class;
---

<article class:list={["flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4", className]}>
	<div id="post-container" class="card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full">
		<slot />
	</div>
</article>
